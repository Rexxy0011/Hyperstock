{
  "name": "@hyperstocks/server",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon",
    "start": "node --env-file-if-exists=.env src/index.js",
    "seed": "node --env-file-if-exists=.env src/seed/seed.js",
    "seed:fresh": "node --env-file-if-exists=.env src/seed/seed.js --fresh",
    "market:probe": "node --env-file-if-exists=.env src/market/probe.js",
    "test": "MONGODB_URI= DEPOSIT_DESTINATIONS=[] DEPOSIT_DESTINATIONS_FILE= WITHDRAWALS_ENABLED=false RESEND_API_KEY= GOOGLE_CLIENT_ID= GOOGLE_CLIENT_SECRET= node --test --env-file-if-exists=.env test/**/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-auth": "^1.7.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "nodemon": "^3.1.14"
  }
}
