# Copy to server/.env and fill in. Every value below is a working default —
# the app boots and is fully demoable with this file copied verbatim.

PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------- database
# Atlas M0 connection string. Leave BLANK to auto-start an in-memory MongoDB
# replica set (no install needed) — data is discarded on shutdown.
MONGODB_URI=

# ------------------------------------------------------------------- auth
# Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
# Better Auth signs session tokens with this. Minimum 32 characters — below
# that the library warns about low entropy at every boot. Generate a real one
# with: openssl rand -base64 32
BETTER_AUTH_SECRET=dev-better-auth-secret-change-me-0123456789

# WHERE THIS API IS REACHABLE FROM THE PUBLIC INTERNET.
#
# Better Auth derives absolute URLs from it, and the one that matters is the
# OAuth callback: {API_ORIGIN}/api/auth/callback/google is what is sent to
# Google and what must be registered in the Cloud Console. Left at the localhost
# default in production, consent succeeds and Google redirects the user to a
# machine that is not there — so the server REFUSES TO BOOT on a localhost
# value when NODE_ENV=production.
#
# This is NOT the client URL and NOT the mail subdomain. Deployed separately,
# those are three different hosts:
#   API_ORIGIN     https://api.hyperstocks.app     (or the Vercel URL)
#   CLIENT_ORIGIN  https://hyperstocks.app         (the site people visit)
#   MAIL_FROM      no-reply@send.hyperstocks.app   (never visited at all)
#
# Blank in development means "derive from PORT".
API_ORIGIN=

# EMAIL — optional. Without a key the mailer PRINTS messages to the terminal in
# development instead of sending, so a fresh clone can still complete a
# code-based sign-in. In production a missing key is logged as the
# misconfiguration it is and nothing is printed: the body of a sign-in mail is
# a live one-time code.
#
# Get a key at https://resend.com (free tier: 3,000/month, 100/day).
# MAIL_FROM must be on a domain verified with the provider. Use a SUBDOMAIN —
# a newsletter that gets spam-flagged should not be able to poison the sender
# reputation that password resets depend on.
RESEND_API_KEY=
MAIL_FROM=HyperStocks <support@hyperstocks.finance>

# GOOGLE OAUTH — optional. Leave both blank and the provider is simply not
# registered: the sign-in screen asks /api/auth-providers and does not render a
# button that cannot work.
#
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and register this exact
# Authorised redirect URI, which is derived from the API's own base URL:
#
#   http://localhost:4000/api/auth/callback/google
#
# In production it is https://your-api-domain/api/auth/callback/google — if the
# base URL is wrong, consent succeeds and the callback lands nowhere.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Superseded by Better Auth and read by nothing. Kept only because deployed
# environments still set them; safe to delete once none do.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# ----------------------------------------------------------- market data
# yahoo  — live quotes + candles, all 8 exchanges, no API key (default)
# finnhub — US quotes only, needs MARKET_DATA_API_KEY, no candles on free tier
# mock   — deterministic simulated prices, fully offline
MARKET_DATA_PROVIDER=yahoo
MARKET_DATA_API_KEY=

QUOTE_REFRESH_MS=15000
QUOTE_FULL_REFRESH_MS=60000
QUOTE_MAX_AGE_MS=120000
MAX_SLIPPAGE_PCT=0.5

# ------------------------------------------------------------------ news
# finnhub — 60 req/min free, US-centric coverage. Get a key at finnhub.io.
# rss     — Nasdaq's public feed, no key. Also where finnhub falls back to
#           when the key is missing, rejected, or the vendor is down.
# none    — no market news at all; /news shows announcements only.
NEWS_PROVIDER=finnhub
FINNHUB_API_KEY=

# The quota guard. TTL is how long an article stays servable; MIN_FETCH is the
# floor between vendor calls for the same feed, however many people ask.
NEWS_TTL_MS=900000
NEWS_MIN_FETCH_MS=300000
NEWS_TIMEOUT_MS=6000

# --------------------------------------------------------------- markets
# Crypto (CoinGecko) and forex (ECB via Frankfurter) need no key at all.
# Live equity quotes reuse FINNHUB_API_KEY and reach US venues only — the
# free tier 403s Euronext, XETRA, LSE, TSE, HKEX and SSE.
#
# TWELVEDATA_API_KEY covers those six. Free key from twelvedata.com; there is
# no demo path (apikey=demo returns 401). Leave it blank and those rows keep
# their seeded reference prices, labelled "Delayed" in the table.
TWELVEDATA_API_KEY=

# Real-time ticks come over a Finnhub WebSocket, not by polling faster: the
# REST quote endpoint is one call per symbol against 60/min, so a 5s interval
# would be 204 calls a minute. The socket is one connection, and it carries US
# equities and crypto together. Forex has no free real-time source and stays
# on the ECB's daily publication.
MARKET_MIN_FETCH_MS=60000
MARKET_TIMEOUT_MS=6000

# --------------------------------------------------------------- trading
SEED_CASH=10000
MAX_TOPUP_AMOUNT=5000

# ------------------------------------------------------------- deposits
# Where crypto deposits should be sent, as JSON:
#   [{"asset":"USDT","network":"TRC20","address":"...","minAmount":10}]
#
# EMPTY BY DEFAULT AND THAT IS THE SAFE STATE. With no entry, deposit.service
# refuses to open a deposit (NO_DESTINATION) and the funding screen says the
# method is not enabled — so no screen can ever ask anyone to send money to a
# blank or placeholder address.
#
# Put a real address in server/.env only. Never here: this file is committed.
# TREASURY ADDRESSES — where deposits are received.
#
# EMPTY BY DEFAULT AND THAT IS THE SAFE STATE. `createDeposit` refuses with
# NO_DESTINATION and the funding screen says so, rather than rendering a form
# with a blank address in it. Filling these in makes real crypto deposits
# reachable, and NOTHING IN THIS REPOSITORY MONITORS A CHAIN OR SENDS FUNDS —
# a deposit is noticed only when the depositor pastes a hash and a human checks
# it, and an approved withdrawal records that an operator paid out by hand.
#
# ONE SOURCE: this variable, as a single line of JSON. Deliberately not a file
# — a second config path that takes precedence is how an operator's edits get
# silently ignored while they believe the change is live.
#
# Required per entry: asset, network, address, minAmount, decimals.
# Optional: assetGroup, priceSymbol, label, note — see the deposit section of
# CLAUDE.md for what each is for (BTCB on BEP20 is the case they exist for).
DEPOSIT_DESTINATIONS=[]

# WHICH CHAINS PAYOUTS MAY BE SENT ON, as JSON. Decoupled from deposits: the
# receiving list used to cap payouts, and there is no reason the two must match
# — a treasury can pay out on a chain nobody deposits to.
#
# NO ADDRESS HERE. The user supplies theirs; this only says which pairs are
# offered. Entries are {asset, network, decimals}.
#
# Empty means "derive from DEPOSIT_DESTINATIONS", the original behaviour.
#
# Networks with a real address rule (anything else falls back to a length check,
# which is not a check — see the withdrawal section of CLAUDE.md):
#   BITCOIN LITECOIN DOGECOIN TRC20 SPL SOLANA
#   ETHEREUM ERC20 BEP20 POLYGON ARBITRUM OPTIMISM BASE AVALANCHE
#
# decimals is QUOTE PRECISION, not the chain's native precision. Use 6-8: an
# 18-decimal quote is a figure nobody can send and no reviewer can match.
WITHDRAWAL_NETWORKS=[]
DEPOSIT_MIN_CONFIRMATIONS=1
DEPOSIT_TTL_MINUTES=30
